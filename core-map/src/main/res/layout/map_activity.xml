<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0D47A1"
        android:padding="12dp"
        android:text="SOS Mesh"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/mapStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp"
        android:text="Bản đồ online/offline (MapLibre + MBTiles)"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/locationStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingTop="2dp"
        android:text="Định vị: Đang lấy tọa độ GPS (Fused Location)..."
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/coordinatesText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:text="Tọa độ: đang chờ Fused Location / GNSS"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/addressText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingBottom="4dp"
        android:text="Địa chỉ: đang chờ tọa độ"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/meshStatusBannerText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#ECEFF1"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="Trạng thái Mesh P2P_CLUSTER: Đang khởi tạo..."
        android:textColor="#1A237E"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/primaryActionButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="4dp"
        android:backgroundTint="#D32F2F"
        android:paddingVertical="10dp"
        android:text="GỬI SOS MỘT CHẠM (≤ 3 THAO TÁC)"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingBottom="2dp">

        <Button
            android:id="@+id/refreshLocationButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Làm mới GPS"
            android:textSize="11sp" />

        <Button
            android:id="@+id/downloadOfflineButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tải bản đồ offline"
            android:textSize="11sp" />

        <Button
            android:id="@+id/reloadMapButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tải lại bản đồ"
            android:textSize="11sp" />
    </LinearLayout>

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FAFAFA"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <Button
            android:id="@+id/alertButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cảnh báo ALERT"
            android:textSize="11sp" />

        <Button
            android:id="@+id/chatButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nhắn tin CHAT"
            android:textSize="11sp" />

        <Button
            android:id="@+id/safetyGuideButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="An toàn Offline"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
